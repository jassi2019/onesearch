# Copy this file to .env.local and fill in your API keys.
# All three providers have generous free tiers.

# https://unsplash.com/developers  (Demo apps: 50 requests/hour)
UNSPLASH_ACCESS_KEY=

# https://www.pexels.com/api/  (200 requests/hour, 20k/month)
PEXELS_API_KEY=

# https://pixabay.com/api/docs/  (100 requests/60s)
PIXABAY_API_KEY=
