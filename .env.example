# Copy this file to .env.local and fill in your API keys.
# All three providers have generous free tiers.

# https://unsplash.com/developers  (Demo apps: 50 requests/hour)
UNSPLASH_ACCESS_KEY=

# https://www.pexels.com/api/  (200 requests/hour, 20k/month)
PEXELS_API_KEY=

# https://pixabay.com/api/docs/  (100 requests/60s)
PIXABAY_API_KEY=

# https://developers.pinterest.com — OAuth access token from your Pinterest app.
# Pinterest has no keyless/public search API; app approval (trial access) is required.
PINTEREST_ACCESS_TOKEN=

# Random secret for signing download-proxy URLs (any long random string)
DOWNLOAD_SIGNING_SECRET=
